server {
    listen ${NGINX_PORT};
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Docker embedded DNS — resolve upstream hostnames at runtime
    # so Nginx starts even if the backend container isn't ready yet
    resolver 127.0.0.11 valid=10s;

    # Proxy API requests to the backend
    # Using a variable defers DNS resolution to request time (not startup)
    location /api/ {
        set $backend_url "http://${BACKEND_HOST}:${BACKEND_PORT}";
        proxy_pass $backend_url;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback — serve index.html for all non-file routes
    location / {
        try_files $uri $uri/ /index.html;
    }
}
