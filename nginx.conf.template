server {
    listen ${NGINX_PORT};
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Docker embedded DNS — resolve upstream hostnames at runtime
    # so Nginx starts even if the backend container isn't ready yet
    resolver 127.0.0.11 valid=10s;

    # Proxy API requests to the backend
    # NOTE: Jangan gunakan variable dengan full URL untuk proxy_pass.
    # Hostname sslip.io dari Coolify mengandung segmen IP (cth: xxx.70.153.138.192.sslip.io)
    # yang membuat Nginx URL parser error "invalid port in upstream" saat variable di-parse di runtime.
    # Solusi: Gunakan literal ${BACKEND_HOST}:${BACKEND_PORT} langsung (di-substitusi oleh envsubst
    # saat container start) — Nginx mem-parse URL sekali di startup, tidak di runtime.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback — serve index.html for all non-file routes
    location / {
        try_files $uri $uri/ /index.html;
    }
}
