server {
    listen ${NGINX_PORT};
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html;

    # Docker embedded DNS — resolve upstream hostnames at runtime
    # so Nginx starts even if the backend container isn't ready yet
    resolver 127.0.0.11 valid=10s;

    # Proxy API requests to the backend
    # NOTE: Hostname sslip.io dari Coolify mengandung segmen IP (cth: xxx.70.153.138.192.sslip.io)
    # yang membuat Nginx URL parser error "invalid port in upstream".
    # Solusi: Simpan hostname di variable ($backend_host) via set — Nginx tidak parse URL
    # saat config load; runtime resolve pakai resolver 127.0.0.11 (Docker DNS).
    location /api {
        set $backend_host "${BACKEND_HOST}";
        set $backend_port "${BACKEND_PORT}";
        proxy_pass http://$backend_host:$backend_port;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback — serve index.html for all non-file routes
    location / {
        try_files $uri $uri/ /index.html;
    }
}
