# =============================================================
# BQ Viewer Frontend — Nginx Config (for Coolify / Docker)
# =============================================================

# Port Nginx akan listen (default: 80)
NGINX_PORT=80

# Hostname / address backend API
# Dalam satu Docker Compose stack: gunakan nama service "backend"
# Jika backend di server terpisah: isi dengan IP/domain backend
BACKEND_HOST=backend

# Port backend API (default: 5000)
BACKEND_PORT=5000
